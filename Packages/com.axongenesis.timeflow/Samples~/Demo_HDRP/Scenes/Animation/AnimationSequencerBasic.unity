MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2117362736}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: "This scene shows how Unity animation clips can be sequenced. This works
    with Animator and Animation components. When an animation clip channel is added
    to Timeflow, it is interpolated based on the keyframe curve in the Timeflow view,
    which fully controls the speed of the clip.\n\nNote that blending multiple animation
    clips is not supported and only 1 animation clip can be playing on each object
    at a time. However, Timeflow can be used alternatively to animate states and
    parameters exposed in Animator blend trees which can perform complex animation
    blending. \n"
  Warning: 
  URLTitle: Animation Clips
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/animation/animation-clips
  URL2Title: Animator Blend Trees
  URL2: https://axongenesis.gitbook.io/timeflow/reference/examples/animator-blend-trees
