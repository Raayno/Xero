--- !u!114 &2142768119
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2142768116}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: 'This scene demonstrates a standard render setup using multiple cameras
    with multiple file outputs. Each camera is sequenced using Timeflow. If more
    than 1 camera is active at a time, whichever has highest priority determines
    the final output. This uses Camera.current with Camera.main as a fallback.


    Note
    that you may render multiple cameras to a single output and they are only separated
    in this example to show that it is possible.'
  Warning: 
  URLTitle: Render To Disk Documentation
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/rendering/render-to-disk
  URL2Title: 
  URL2: 
