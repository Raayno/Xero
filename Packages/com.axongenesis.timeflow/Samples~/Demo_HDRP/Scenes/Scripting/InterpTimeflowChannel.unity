  m_Name: 
  m_EditorClassIdentifier: 
  Comments: "This script uses the Input Time to interpolate the specified channel
    (Local Rotation Z) to get the Output Value from that channel. \n\nThe Input Time
    is animated in Timeflow to demonstrate arbitrary remapping, and the Output Value
    is displayed on a UI text object using Channel Link to output the value as text."
  Warning: 
  URLTitle: 
  URL: 
  URL2Title: 
  URL2: 
