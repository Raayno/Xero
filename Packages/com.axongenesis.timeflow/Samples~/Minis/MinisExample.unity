--- !u!114 &1892227392
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1892227388}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: 'This has been mapped to middle C on a midi keyboard. With your own midi
    device connected, play this scene and press the Map button above. Once a note
    or knob has been detected, it shows mapped in green. Further pressing the key,
    button, or knob on the midi device now triggers the behavior. This mapping is
    saved between run sessions so can be done as a one-time setup, or remapped on
    the fly as needed.


    If using QWERTY input, you may additionally map keyboard
    keys to notes while maintaining midi assignments.

'
  Warning: 
  URLTitle: 
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/midi/midi-receiver
  URL2Title: 
  URL2: 
