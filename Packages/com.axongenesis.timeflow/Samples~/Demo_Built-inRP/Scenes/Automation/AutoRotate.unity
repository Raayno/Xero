  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: 'This scene demonstrates the use of AutoRotate to automatically align
    objects relative to their direction of travel. This is often useful for objects
    traveling along a path. '
  Warning: Although not required, it is advised to use Late Update with AutoRotate
    components to avoid any order dependency issues. This often solves problems if
    there is any jitter or unsteady movement in the rotation.
  URLTitle: Auto Rotate Documentation
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/automation/auto-rotate
  URL2Title: Update Settings Documentation
  URL2: https://axongenesis.gitbook.io/timeflow/user-guide/timeflow-editor/update-settings
