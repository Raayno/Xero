--- !u!114 &165000086
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 165000084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: 'This scene demonstrates the use of the Distance behavior to calculate
    world distance between transforms which can be applied to scale and mapped to
    other properties using channel links.


    The dotted line between the RedSphere
    and BlueCube uses Look At to orient the line from the cube to the sphere, and
    scales dynamically using Distance.


    The YellowRuler at the top is the absolute
    distance between the RedSphere and BlueCube.


    And the GreenRuler at the
    bottom is the BlueCube''s distance from the world center (or Timeflow root).

    https://axongenesis.gitbook.io/timeflow/reference/behaviors/automation/distance'
  Warning: 
  URLTitle: Distance Documentation
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/automation/distance
  URL2Title: 
  URL2: 
