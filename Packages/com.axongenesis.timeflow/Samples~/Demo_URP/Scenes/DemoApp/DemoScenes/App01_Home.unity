    - target: {fileID: 3411689365065134528, guid: c7173afd29f95f44bbf0fefb3b37a157, type: 3}
      propertyPath: m_text
      value: 'Timeflow is a powerful and flexible animation system for Unity offering
        a new range of creative possibilities for artists and developers. With a
        focus on motion graphics and music synchronization, Timeflow offers a robust
        integrated track and channel based timeline with advanced curve editing tools,
        procedural animations, dynamic behaviors, and much more. This app demonstrates
        some of the key features of Timeflow for both choreographed and interactive
        contexts.


        <align="center">For more information visit: axongenesis.com/timeflow</align>'
      objectReference: {fileID: 0}
