--- !u!114 &654014590
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 654014588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: "This scene demonstrates how to animate blend shapes on SkinnedMeshRenderer
    components. Two examples are provided.\n\nThe BlueAlien on the left has blend
    shapes animated using keyframer channels, while the RedAlien on the left uses
    Blend to define a series of named facial expressions to animate between. \n\nBlend
    shapes are exposed as properties of the SkinnedMeshRenderer and may be animated
    like any other property. The examples provided here are just a couple of many
    possibilities."
  Warning: 
  URLTitle: Blend Shapes Documentation
  URL: https://axongenesis.gitbook.io/timeflow/reference/examples/blend-shapes
  URL2Title: 
  URL2: 
