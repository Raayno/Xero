  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ff6acaa8b9f1994499dd387e6188532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Comments: "This scene shows how a character can be placed using Motion Path. It
    is recommended to apply the Motion Path to a parent object, to separate it from
    the character motion.\n\nTimeflow does not support IK constraints, though you
    may use Unity's constraints and IK tools for this purpose. \n"
  Warning: It is important that Motion Path is not applied to the same object as
    an Animator component which controls the position of the object, otherwise unpredictable
    results may occur.
  URLTitle: Animation Clips
  URL: https://axongenesis.gitbook.io/timeflow/reference/behaviors/animation/animation-clips
  URL2Title: Animator Blend Trees
  URL2: https://axongenesis.gitbook.io/timeflow/reference/examples/animator-blend-trees
