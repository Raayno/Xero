*.pidb
*.booproj
*.svd

# Rider / JetBrains
.idea/

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# Unity Addressables generated files
# =========================================================

/Assets/AddressableAssetsData/*/*.bin*
/Assets/AddressableAssetsData/*/BuildScriptPackedMode.asset
/[Aa]sset[Bb]undles/

# Addressables build output
/ServerData/

# =========================================================
# Wwise Unity Integration - generated/cache files
# =========================================================

# Wwise Picker temporary project data
/Assets/Wwise/Editor/ProjectData/AkWwiseProjectData.asset*
/Assets/Wwise/Editor/ProjectData/*.asset

# Wwise generated soundbanks inside Unity
/Assets/StreamingAssets/Audio/GeneratedSoundBanks/
/Assets/StreamingAssets/Audio/GeneratedSoundBanks.meta

# Wwise addressables generated soundbanks/cache, if used
/Assets/Wwise/Addressables/GeneratedSoundBanks/
/Assets/Wwise/Addressables/GeneratedSoundBanks.meta

# Wwise generated build/cache folders
/Assets/Wwise/Deployment/
/Assets/Wwise/Deployment.meta

# =========================================================
# Wwise Project generated files
# Adjust path if your Wwise project folder name is different
# Example: /WwiseProject/
# =========================================================

# Wwise caches
/WwiseProject/.cache/
/WwiseProject/Cache/
/WwiseProject/.WwiseCache/
/WwiseProject/Originals/SFX/**/*.akd
/WwiseProject/Originals/Music/**/*.akd

# Wwise generated soundbanks
/WwiseProject/GeneratedSoundBanks/
/WwiseProject/GeneratedSoundBanks.meta

# Wwise profiler/capture/generated temp files
/WwiseProject/**/*.prof
/WwiseProject/**/*.profiler
/WwiseProject/**/*.wav.cache
/WwiseProject/**/*.wem.cache

# Wwise logs
/WwiseProject/**/*.log

# =========================================================
# Keep these Wwise project files in Git
# =========================================================

!/WwiseProject/*.wproj
!/WwiseProject/**/*.wwu
!/WwiseProject/**/*.wav
!/WwiseProject/**/*.aif
!/WwiseProject/**/*.aiff
!/WwiseProject/**/*.mp3
!/WwiseProject/**/*.flac
!/WwiseProject/**/*.ogg

# =========================================================
# IMPORTANT:
# Do NOT ignore Unity .meta files
# =========================================================

!*.meta
*.zip
/Assets/PlayModeChangesSaver
Assets/_XERO/Fonts/UsedFonts/DMSerifDisplay-Regular SDF.asset
